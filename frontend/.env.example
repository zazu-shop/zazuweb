# URL del backend (Node/Express). En local: http://localhost:4000
# En Vercel: la URL pública de tu backend desplegado.
VITE_API_URL=http://localhost:4000

# Solo si usas Supabase directo desde el navegador (auth, etc.)
# Usa SIEMPRE la anon key aquí, nunca la service_role key.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica
